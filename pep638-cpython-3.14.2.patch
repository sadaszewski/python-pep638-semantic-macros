+class StmtExprTests(unittest.TestCase):
+
+    def test_stmt_expr(self):
+        ns = run(using("once") + """\
+            calls = []
+            def f():
+                calls.append(1)
+                return len(calls)
+            result = [0, once!(f()), 2]
+            """)
+        self.assertEqual(ns["result"], [0, (1, 1), 2])
+        self.assertEqual(ns["calls"], [1])
+
+    def test_in_function(self):
+        ns = run(using("once", "attempt_or") + """\
+            def f(x, y):
+                return once!(x + y), attempt_or!(x / y, "undefined"), x
+            def g(*args):
+                return [attempt_or!(1 / arg, None) for arg in args]
+            """)
+        self.assertEqual(ns["f"](1, 2), ((3, 3), 0.5, 1))
+        self.assertEqual(ns["f"](1, 0), ((1, 1), "undefined", 1))
+        self.assertEqual(ns["g"](1, 0, 2), [1.0, None, 0.5])
+        # generated names do not leak into the namespace as identifiers
+        self.assertEqual([name for name in ns["f"].__code__.co_varnames
+                          if name.isidentifier()], ["x", "y"])
+
+    def test_nested_statements(self):
+        ns = run(using("with_stmt") + """\
+            def f(n):
+                total = 0
+                return (with_stmt!('''for i in range(n):
+                    if i == 3:
+                        continue
+                    if i == 5:
+                        break
+                    total += i
+                '''), total)
+            def gen():
+                x = [with_stmt!("yield 1"), with_stmt!("yield 2")]
+                yield x
+            """)
+        self.assertEqual(ns["f"](10), (None, 0 + 1 + 2 + 4))
+        self.assertEqual(list(ns["gen"]()), [1, 2, [None, None]])
+
+    def test_nested_function(self):
+        ns = run(using("with_stmt") + """\
+            def f():
+                return (with_stmt!('''def g(x):
+                    return x + 1
+                '''), g(1))
+            """)
+        self.assertEqual(ns["f"](), (None, 2))
+
+    def test_cannot_jump_out(self):
+        for stmt in "return 1", "break", "continue":
+            with self.subTest(stmt=stmt):
+                code = using("with_stmt") + dedent(f"""\
+                    def f():
+                        for i in range(3):
+                            x = [i, with_stmt!("{stmt}")]
+                    """)
+                with self.assertRaisesRegex(SyntaxError, "cannot be used to "
+                                            "leave the statement"):
+                    run(code)
