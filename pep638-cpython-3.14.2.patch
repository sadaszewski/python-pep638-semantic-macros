+class ParserTests(unittest.TestCase):
+
+    def parse_stmt(self, source):
+        stmt, = ast.parse(textwrap.dedent(source)).body
+        return stmt
+
+    def test_statement(self):
+        node = self.parse_stmt("spam!")
+        self.assertIsInstance(node, ast.MacroStmt)
+        self.assertIsInstance(node, ast.stmt)
+        self.assertEqual(node.name, "spam")
+        self.assertIsNone(node.args)
+        self.assertIsNone(node.importname)
+        self.assertIsNone(node.asname)
+        self.assertEqual(node.body, [])
+        self.assertEqual((node.lineno, node.col_offset,
+                          node.end_lineno, node.end_col_offset), (1, 0, 1, 5))
+
+    def test_statement_arguments(self):
+        node = self.parse_stmt("spam! a")
+        self.assertIsInstance(node.args, ast.Name)
+        node = self.parse_stmt("spam! a, b + 1")
+        self.assertIsInstance(node.args, ast.Tuple)
+        self.assertEqual(len(node.args.elts), 2)
+        node = self.parse_stmt("spam! a import b as c")
+        self.assertEqual(node.importname, "b")
+        self.assertEqual(node.asname, "c")
+        node = self.parse_stmt("spam! as c")
+        self.assertIsNone(node.args)
+        self.assertEqual(node.asname, "c")
+
+    def test_statement_body(self):
+        node = self.parse_stmt("""\
+            spam! a as b:
+                x = 1
+                eggs!:
+                    pass
+            """)
+        self.assertEqual(node.asname, "b")
+        self.assertEqual(len(node.body), 2)
+        self.assertIsInstance(node.body[1], ast.MacroStmt)
+        self.assertIsInstance(node.body[1].body[0], ast.Pass)
+        node = self.parse_stmt("spam!: x = 1; y = 2")
+        self.assertEqual(len(node.body), 2)
+
+    def test_statement_takes_precedence(self):
+        # "The statement form of a macro takes precedence"
+        node = self.parse_stmt("spam!(x)")
+        self.assertIsInstance(node, ast.MacroStmt)
+        self.assertIsInstance(node.args, ast.Name)
+        node = self.parse_stmt("(spam!(x))")
+        self.assertIsInstance(node, ast.Expr)
+        self.assertIsInstance(node.value, ast.MacroExpr)
+
+    def test_simple_statements(self):
+        tree = ast.parse("spam! a; eggs! b; x = 1")
+        self.assertEqual([type(stmt).__name__ for stmt in tree.body],
+                         ["MacroStmt", "MacroStmt", "Assign"])
+
+    def test_keywords_as_names(self):
+        for name in ("import", "from", "with", "try", "match", "case",
+                     "finally", "if", "class", "lambda", "type"):
+            with self.subTest(name=name):
+                node = self.parse_stmt(f"{name}! x")
+                self.assertEqual(node.name, name)
+                node = self.parse_stmt(f"y = {name}!(x)")
+                self.assertEqual(node.value.name, name)
+
+    def test_expression(self):
+        node = self.parse_stmt("x = spam!(a, b)").value
+        self.assertIsInstance(node, ast.MacroExpr)
+        self.assertIsInstance(node, ast.expr)
+        self.assertEqual(node.name, "spam")
+        self.assertIsInstance(node.args, ast.Tuple)
+        self.assertEqual((node.col_offset, node.end_col_offset), (4, 15))
+        node = self.parse_stmt("x = spam!()").value
+        self.assertIsNone(node.args)
+        node = self.parse_stmt("x = spam!(a).b[0] + spam!(c)").value
+        self.assertIsInstance(node.left.value.value, ast.MacroExpr)
+        self.assertIsInstance(node.right, ast.MacroExpr)
+        node = self.parse_stmt("x = spam!(i for i in y)").value
+        self.assertIsInstance(node.args, ast.GeneratorExp)
+        node = self.parse_stmt("with! open!(filename) as fd: pass")
+        self.assertIsInstance(node.args, ast.MacroExpr)
+        self.assertEqual(node.asname, "fd")
+
+    def test_macro_body_assignment(self):
+        # The examples of the PEP use assignments to arbitrary expressions
+        # in the body of a macro
+        node = self.parse_stmt("""\
+            bijection! color_to_code, code_to_color:
+                "red" = 1
+                "blue" = 2
+                a = b
+                f(x) = y = 3
+            """)
+        red, blue, valid, call = node.body
+        self.assertIsInstance(red.targets[0], ast.Constant)
+        self.assertEqual(red.targets[0].value, "red")
+        self.assertEqual(blue.value.value, 2)
+        self.assertIsInstance(valid.targets[0].ctx, ast.Store)
+        self.assertIsInstance(call.targets[0], ast.Call)
+        self.assertEqual(len(call.targets), 2)
+
+    def test_pep_names(self):
+        self.assertIs(ast.macro_stmt, ast.MacroStmt)
+        self.assertIs(ast.macro_expr, ast.MacroExpr)
+        self.assertIs(ast.stmt_expr, ast.StmtExpr)
+        self.assertEqual(ast.MacroStmt._fields,
+                         ("name", "args", "importname", "asname", "body"))
+        self.assertEqual(ast.MacroExpr._fields, ("name", "args"))
+        self.assertEqual(ast.StmtExpr._fields, ("stmt", "value"))
+        self.assertEqual({ast.STMT_MACRO, ast.SIBLING_MACRO, ast.EXPR_MACRO},
+                         {macros.STMT_MACRO, macros.SIBLING_MACRO,
+                          macros.EXPR_MACRO})
+
+    def test_syntax_errors(self):
+        for source in (
+            "x = spam!",
+            "x = spam! y",
+            "spam ! y",
+            "spam!:",
+            "spam!:\npass",
+            "spam! import",
+            "spam! as",
+            "spam! x as y import z",
+            "from! spam import a, b",
+            "x = spam!(y",
+            "'red' = 1",
+            "if x:\n    'red' = 1",
+            "spam!:\n    if x:\n        'red' = 1",
+            "spam!:\n    'red' == 1 = = 2",
+            "1!(x)",
+        ):
+            with self.subTest(source=source):
+                with self.assertRaises(SyntaxError):
+                    ast.parse(source)
+
+    def test_unparse(self):
+        for source in (
+            "spam!",
+            "spam! a",
+            "spam! a, b",
+            "spam! a,",
+            "spam! a.b import c as d",
+            "spam! as d",
+            "spam! (a, b), c:\n    x = 1\n    eggs!:\n        pass",
+            "spam!:\n    'red' = 1",
+            "x = spam!()",
+            "x = spam!(a)",
+            "x = spam!(a, b)",
+            "x = spam!(a,)",
+            "x = spam!(())",
+            "x = spam!((a, b), c).d",
+            "x = spam!(i for i in y)",
+            "x = f'{spam!(a)!r}'",
+        ):
+            with self.subTest(source=source):
+                tree = ast.parse(source)
+                self.assertEqual(ast.unparse(tree), source)
+                self.assertEqual(ast.dump(ast.parse(ast.unparse(tree))),
+                                 ast.dump(tree))
+
+    def test_unparse_stmt_expr(self):
+        node = ast.StmtExpr(ast.Assign([store("a")], ast.Constant(1)),
+                            load("a"))
+        ast.fix_missing_locations(node)
+        self.assertEqual(ast.unparse(node), "$stmt_expr(a = 1; a)")
+
+    def test_ast_roundtrip(self):
+        # The compiler accepts trees with macros
+        tree = ast.parse(using("unless") + "unless! False:\n    x = 1\n")
+        ns = {}
+        exec(compile(tree, "<test>", "exec"), ns)
+        self.assertEqual(ns["x"], 1)
+        # and ast.parse() does not expand them
+        tree2 = compile(tree, "<test>", "exec", ast.PyCF_ONLY_AST)
+        self.assertIsInstance(tree2.body[-1], ast.MacroStmt)
+
