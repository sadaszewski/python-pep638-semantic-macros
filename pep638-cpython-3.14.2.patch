+# Macros (PEP 638)
+# -----------------
+
+# The statement form takes precedence over the expression form: a statement
+# that starts with a MACRO_NAME is always a macro statement.
+
+macro_block_stmt[stmt_ty]:
+    | n=MACRO_NAME a=[star_expressions] i=[macro_import_name] s=[macro_as_name] ':' b=macro_block {
+        _PyAST_MacroStmt(
+            CHECK(PyObject*, _PyPegen_macro_name(p, n)), a,
+            i ? ((expr_ty) i)->v.Name.id : NULL,
+            s ? ((expr_ty) s)->v.Name.id : NULL,
+            b, EXTRA) }
+
+macro_simple_stmt[stmt_ty]:
+    | invalid_macro_stmt
+    | n=MACRO_NAME a=[star_expressions] i=[macro_import_name] s=[macro_as_name] {
+        _PyAST_MacroStmt(
+            CHECK(PyObject*, _PyPegen_macro_name(p, n)), a,
+            i ? ((expr_ty) i)->v.Name.id : NULL,
+            s ? ((expr_ty) s)->v.Name.id : NULL,
+            NULL, EXTRA) }
+
+# The body of a macro is only given a meaning by its macro processor, so a
+# statement of the body can also be an "assignment" to arbitrary expressions,
+# as in:
+#
+#     bijection! color_to_code, code_to_color:
+#         "red" = 1
+#         "blue" = 2
+
+macro_block[asdl_stmt_seq*]:
+    | NEWLINE INDENT a=macro_statement+ DEDENT { (asdl_stmt_seq*)_PyPegen_seq_flatten(p, a) }
+    | simple_stmts
+    | invalid_block
+
+macro_statement[asdl_stmt_seq*]:
+    | a=macro_assignment NEWLINE { (asdl_stmt_seq*)_PyPegen_singleton_seq(p, a) }
+    | statement
+
+macro_assignment[stmt_ty]:
+    | a[asdl_expr_seq*]=(z=star_expressions '=' { z })+ b=annotated_rhs !'=' {
+        _PyPegen_macro_assignment(p, a, b, EXTRA) }
+
+macro_import_name[expr_ty]: 'import' a=NAME { a }
+macro_as_name[expr_ty]: 'as' a=NAME { a }
+
+macro_expr[expr_ty]:
+    | n=MACRO_NAME '(' a=[star_expressions] ')' {
+        _PyAST_MacroExpr(CHECK(PyObject*, _PyPegen_macro_name(p, n)), a, EXTRA) }
+    | n=MACRO_NAME a=genexp {
+        _PyAST_MacroExpr(CHECK(PyObject*, _PyPegen_macro_name(p, n)), a, EXTRA) }
+    | invalid_macro_expr
+
 # SIMPLE STATEMENTS
 # =================
 
