+class ImportTests(unittest.TestCase):
+
+    def test_from(self):
+        ns = run(f"""\
+            from! {MACROS_MODULE} import swap
+            from! {MACROS_MODULE} import swap as exchange
+            x = swap!(1, 2), exchange!(3, 4)
+            """)
+        self.assertEqual(ns["x"], ((2, 1), (4, 3)))
+        # the macros are not available at run time
+        self.assertNotIn("swap", ns)
+        self.assertNotIn("exchange", ns)
+
+    def test_import(self):
+        ns = run(f"""\
+            import! {MACROS_MODULE}.swap as exchange
+            import! {MACROS_MODULE}.source
+            x = exchange!(1, 2), source!(a)
+            """)
+        self.assertEqual(ns["x"], ((2, 1), "a"))
+
+    def test_scope(self):
+        ns = run(f"""\
+            def f():
+                from! {MACROS_MODULE} import swap
+                def g():
+                    return swap!(1, 2)
+                return g()
+            class C:
+                from! {MACROS_MODULE} import swap
+                x = swap!(3, 4)
+            x = f()
+            """)
+        self.assertEqual(ns["x"], (2, 1))
+        self.assertEqual(ns["C"].x, (4, 3))
+        # "import! and from! only define the macro for the scope in which
+        # the import is present"
+        with self.assertRaisesRegex(SyntaxError, "'swap!' is not defined"):
+            run(f"""\
+                def f():
+                    from! {MACROS_MODULE} import swap
+                x = swap!(1, 2)
+                """)
+
+    def test_must_be_imported_before_use(self):
+        with self.assertRaisesRegex(SyntaxError, "'swap!' is not defined"):
+            run(f"""\
+                x = swap!(1, 2)
+                from! {MACROS_MODULE} import swap
+                """)
+
+    def test_shadowing(self):
+        ns = run(f"""\
+            from! {MACROS_MODULE} import swap as m
+            def f():
+                from! {MACROS_MODULE} import source as m
+                return m!(a, b)
+            x = m!(1, 2), f()
+            """)
+        self.assertEqual(ns["x"], ((2, 1), "(a, b)"))
+
+    def test_recorded(self):
+        ns = run(f'''\
+            """Docstring."""
+            from __future__ import annotations
+            from! {MACROS_MODULE} import swap
+            def f():
+                from! {MACROS_MODULE} import attempt as do
+            ''')
+        self.assertEqual(ns["__doc__"], "Docstring.")
+        self.assertEqual(ns["__macros__"],
+                         ("$macros", (MACROS_MODULE, "swap", 1),
+                          (MACROS_MODULE, "attempt", 3)))
+        self.assertNotIn("__macros__", run("x = 1"))
+
+    def test_errors(self):
+        for code, exception, message in (
+            ("from! no_such_module_xyz import x",
+             ModuleNotFoundError, "no_such_module_xyz"),
+            (f"from! {MACROS_MODULE} import no_such_macro",
+             ImportError, "cannot import macro 'no_such_macro'"),
+            (f"from! {MACROS_MODULE} import not_a_macro",
+             SyntaxError, "is not a macro processor"),
+            (f"from! {MACROS_MODULE}", SyntaxError, "invalid syntax for from!"),
+            ("from! import x", SyntaxError, "must be followed by"),
+            ("from! f(x) import x", SyntaxError, "must be followed by"),
+            (f"x = 1\nfrom! {MACROS_MODULE} import swap:\n    pass",
+             SyntaxError, "invalid syntax for from!"),
+            ("import! swap", SyntaxError, "import! requires"),
+            (f"import! {MACROS_MODULE} import swap",
+             SyntaxError, "invalid syntax for import!"),
+            ("x = import!(a)", SyntaxError, "cannot be used in an expression"),
+        ):
+            with self.subTest(code=code):
+                with self.assertRaisesRegex(exception, message):
+                    run(code)
