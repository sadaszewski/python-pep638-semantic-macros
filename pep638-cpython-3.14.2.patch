+    def test_symtable(self):
+        table = symtable.symtable(using("once") + textwrap.dedent("""\
+            def f(a):
+                return once!(a)
+            """), "<test>", "exec")
+        f, = [child for child in table.get_children()
+              if child.get_name() == "f"]
+        names = set(f.get_identifiers())
+        self.assertIn("a", names)
+        self.assertEqual(len(names), 2)
+        generated, = names - {"a"}
+        self.assertTrue(generated.startswith("$$once_"))
+        self.assertTrue(f.lookup(generated).is_local())
