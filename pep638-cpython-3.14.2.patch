+        self.assertEqual(scope, {"swap": swap})
+        code = compile("swap!(1, 2)", "<test>", "eval", macros=scope)
+        self.assertEqual(eval(code), (2, 1))
+        tree = ast.parse("x = swap!(1, 2)")
