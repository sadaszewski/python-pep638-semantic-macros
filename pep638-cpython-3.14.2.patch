+/* PEP 638: return the identifier of a MACRO_NAME token (without the
+   trailing '!'). */
+PyObject *
+_PyPegen_macro_name(Parser *p, Token *t)
+{
+    if (t == NULL) {
+        return NULL;
+    }
+    char *s;
+    Py_ssize_t len;
+    if (PyBytes_AsStringAndSize(t->bytes, &s, &len) < 0) {
+        p->error_indicator = 1;
+        return NULL;
+    }
+    assert(len >= 2 && s[len - 1] == '!');
+    char *name = PyMem_Malloc(len);
+    if (name == NULL) {
+        PyErr_NoMemory();
+        p->error_indicator = 1;
+        return NULL;
+    }
+    memcpy(name, s, len - 1);
+    name[len - 1] = '\0';
+    PyObject *id = _PyPegen_new_identifier(p, name);
+    PyMem_Free(name);
+    return id;
+}
