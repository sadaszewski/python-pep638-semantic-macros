+class ErrorTests(unittest.TestCase):
+
+    def check_syntax_error(self, code, message, lineno, offset):
+        with self.assertRaisesRegex(SyntaxError, message) as cm:
+            run(code)
+        self.assertEqual(cm.exception.filename, "<test>")
+        self.assertEqual(cm.exception.lineno, lineno)
+        self.assertEqual(cm.exception.offset, offset)
+        return cm.exception
+
+    def test_undefined(self):
+        exc = self.check_syntax_error("x = 1\nif x:\n    y = [spam!(x)]\n",
+                                      "macro 'spam!' is not defined", 3, 10)
+        self.assertEqual(exc.end_offset, 18)
+        # no frames of the macro expander in the traceback
+        try:
+            compile("spam!", "<test>", "exec")
+        except SyntaxError as exc:
+            self.assertIsNone(exc.__traceback__.tb_next)
+        else:
+            self.fail("SyntaxError not raised")
+        self.check_syntax_error("\nspam! x:\n    pass\n",
+                                "macro 'spam!' is not defined", 2, 1)
+
+    def test_error_in_processor(self):
+        self.check_syntax_error(using("fails") + "x = 1\nfails! x\n",
+                                "no way", 3, 1)
+        self.check_syntax_error(
+            using("fails_at_body") + "fails_at_body!:\n    x = 1\n",
+            "bad line", 3, 5)
+        with self.assertRaises(ZeroDivisionError) as cm:
+            run(using("crashes") + "crashes!")
+        self.assertIn("crashes!", cm.exception.__notes__[0])
+
+    def test_wrong_result(self):
+        with self.assertRaisesRegex(TypeError, "must return an AST"):
+            run(using("wrong") + "wrong!")
+        returns_stmt = (lambda node: ast.Pass(), macros.EXPR_MACRO, 1, ())
+        with self.assertRaisesRegex(TypeError, "must return an expression"):
+            compile("x = m!()", "<test>", "exec", macros={"m": returns_stmt})
+
+    def test_result_is_validated(self):
+        with self.assertRaises(ValueError):
+            run(using("invalid") + "invalid!")
+
+    def test_endless_expansion(self):
+        with self.assertRaisesRegex(SyntaxError, "recursively without end"):
+            run(using("forever") + "forever!")
+        endless = (lambda node: node, macros.EXPR_MACRO, 1, ())
+        with self.assertRaisesRegex(SyntaxError, "recursively without end"):
+            compile("x = m!()", "<test>", "exec", macros={"m": endless})
+
+    def test_unexpanded(self):
+        # Macros created after the expansion are not accepted
+        tree = ast.parse("x = 1")
+        tree.body.append(ast.MacroStmt("spam", None, None, None, []))
+        ast.fix_missing_locations(tree)
+        with self.assertRaisesRegex(SyntaxError, "'spam!' is not defined"):
+            compile(tree, "<test>", "exec")
