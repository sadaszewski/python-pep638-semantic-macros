+"""Tests for syntactic macros (PEP 638)."""
+
+import ast
+import codeop
+import importlib
+import io
+import macros
+import os
+import symtable
+import sys
+import textwrap
+import token
+import tokenize
+import types
+import unittest
+
+from test.support import import_helper, os_helper
+
+
+# The macro processors used by the tests. They live in a module of their
+# own, as macros are imported at compile time with import! and from!.
+
+MACROS_MODULE = "_test_macros_processors"
+
+
+def load(name):
+    return ast.Name(name, ast.Load())
+
+
+def store(name):
+    return ast.Name(name, ast.Store())
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def unless(node):
+    return ast.If(ast.UnaryOp(ast.Not(), node.args), node.body, [])
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def nothing(node):
+    return None
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def repeat(node):
+    # repeat! n: body  ->  the body, n times (at compile time)
+    return node.body * ast.literal_eval(node.args)
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def bind(node):
+    # bind! value as name
+    return ast.Assign([store(node.asname)], node.args)
+
+
+@macros.macro_processor(macros.STMT_MACRO, 3, "otherwise", "lastly")
+def attempt(node, otherwise, lastly):
+    handlers = []
+    if otherwise is not None:
+        handlers.append(ast.ExceptHandler(load("Exception"), None,
+                                          otherwise.body))
+    finalbody = lastly.body if lastly is not None else []
+    if not handlers and not finalbody:
+        return node.body
+    return ast.Try(node.body, handlers, [], finalbody)
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def table(node):
+    # table! name:
+    #     "key" = value
+    keys = [stmt.targets[0] for stmt in node.body]
+    values = [stmt.value for stmt in node.body]
+    return ast.Assign([store(node.args.id)], ast.Dict(keys, values))
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def forever(node):
+    return node
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def nested(node):
+    # expands to another macro
+    return ast.MacroStmt("unless", node.args, None, None, node.body)
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def parsed(node):
+    return ast.parse("parsed_a = 1\nparsed_b = parsed_a + 1")
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def fails(node):
+    raise SyntaxError("no way")
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def fails_at_body(node):
+    error = SyntaxError("bad line")
+    error.lineno = node.body[0].lineno
+    error.offset = node.body[0].col_offset + 1
+    raise error
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def crashes(node):
+    return 1 / 0
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def wrong(node):
+    return 42
+
+
+@macros.macro_processor(macros.STMT_MACRO, 1)
+def invalid(node):
+    # Assignment to something that cannot be assigned to
+    return ast.Assign([ast.Constant(1)], ast.Constant(2))
+
+
+@macros.macro_processor(macros.SIBLING_MACRO, 1)
+def twice(node):
+    stmt, = node.body
+    return [stmt, stmt]
+
+
+@macros.macro_processor(macros.SIBLING_MACRO, 1)
+def registered(node):
+    # registered!
+    # def f(): ...       ->   def f(): ...; registry.append(f)
+    func, = node.body
+    call = ast.Call(ast.Attribute(load("registry"), "append", ast.Load()),
+                    [load(func.name)], [])
+    return [func, ast.Expr(call)]
+
+
+@macros.macro_processor(macros.EXPR_MACRO, 1)
+def source(node):
+    return ast.Constant(ast.unparse(node.args))
+
+
+@macros.macro_processor(macros.EXPR_MACRO, 1)
+def swap(node):
+    left, right = node.args.elts
+    return ast.Tuple([right, left], ast.Load())
+
+
+@macros.macro_processor(macros.EXPR_MACRO, 1)
+def count(node):
+    if node.args is None:
+        return ast.Constant(0)
+    if isinstance(node.args, ast.Tuple):
+        return ast.Constant(len(node.args.elts))
+    return ast.Constant(1)
+
+
+@macros.macro_processor(macros.EXPR_MACRO, 1)
+def once(node):
+    # Evaluate the argument once, use it twice
+    name = macros.new_name(node)
+    return ast.StmtExpr(
+        ast.Assign([store(name)], node.args),
+        ast.Tuple([load(name), load(name)], ast.Load()))
+
+
+@macros.macro_processor(macros.EXPR_MACRO, 1)
+def attempt_or(node):
+    # attempt_or!(expr, default): a try statement in an expression
+    expr, default = node.args.elts
+    name = macros.new_name(node)
+    handler = ast.ExceptHandler(load("Exception"), None,
+                                [ast.Assign([store(name)], default)])
+    return ast.StmtExpr(
+        ast.Try([ast.Assign([store(name)], expr)], [handler], [], []),
+        load(name))
+
+
+@macros.macro_processor(macros.EXPR_MACRO, 1)
+def with_stmt(node):
+    # with_stmt!(code) evaluates to None after executing the statement
+    # that is given as a string
+    stmt, = ast.parse(ast.literal_eval(node.args)).body
+    return ast.StmtExpr(stmt, ast.Constant(None))
+
+
+@macros.macro_processor(macros.EXPR_MACRO, 1)
+def chained(node):
+    return ast.MacroExpr("source", node.args)
+
+
+def setUpModule():
+    module = types.ModuleType(MACROS_MODULE)
+    for name, value in globals().items():
+        if isinstance(value, tuple) and len(value) == 4 and callable(value[0]):
+            setattr(module, name, value)
+    module.not_a_macro = 42
+    sys.modules[MACROS_MODULE] = module
+    unittest.addModuleCleanup(sys.modules.pop, MACROS_MODULE, None)
+
+
+def using(*names):
+    """Return the source that imports the macros *names*."""
+    return "".join(f"from! {MACROS_MODULE} import {name}\n" for name in names)
+
+
+def dedent(code):
+    # The code of the tests is often using(...) followed by indented code.
+    imports = []
+    lines = code.splitlines(keepends=True)
+    while lines and lines[0].startswith("from! "):
+        imports.append(lines.pop(0))
+    return "".join(imports) + textwrap.dedent("".join(lines))
+
+
+def run(code, **namespace):
+    """Compile and execute *code*; return the namespace."""
+    exec(compile(dedent(code), "<test>", "exec"), namespace)
+    return namespace
+
+
+class TokenizerTests(unittest.TestCase):
+
+    def tokens(self, source):
+        readline = io.StringIO(source).readline
+        return [(token.tok_name[tok.type], tok.string)
+                for tok in tokenize.generate_tokens(readline)
+                if tok.type not in (token.NEWLINE, token.ENDMARKER)]
+
+    def test_macro_name(self):
+        self.assertEqual(self.tokens("spam!(x)"),
+                         [("MACRO_NAME", "spam!"), ("OP", "("),
+                          ("NAME", "x"), ("OP", ")")])
+        self.assertEqual(self.tokens("import! a"),
+                         [("MACRO_NAME", "import!"), ("NAME", "a")])
+        self.assertEqual(self.tokens("é_1!:"),
+                         [("MACRO_NAME", "é_1!"), ("OP", ":")])
+
+    def test_not_equal(self):
+        self.assertEqual(self.tokens("a!=b"),
+                         [("NAME", "a"), ("OP", "!="), ("NAME", "b")])
+        self.assertEqual(self.tokens("a != b"),
+                         [("NAME", "a"), ("OP", "!="), ("NAME", "b")])
+
+    def test_roundtrip(self):
+        source = "spam! a, b:\n    x = eggs!(1)\n"
+        readline = io.StringIO(source).readline
+        result = tokenize.untokenize(tokenize.generate_tokens(readline))
+        self.assertEqual(result, source)
+
+    def test_fstring_conversion(self):
+        x = "a"
+        self.assertEqual(f"{x!r}", "'a'")
+        self.assertEqual(f"{x!s:>3}", "  a")
+        self.assertEqual(f"{x!r}{x!a}", "'a''a'")
+        self.assertEqual(f"{x=!r}", "x='a'")
+        self.assertEqual(f"{x!=x}", "False")
+
+    def test_macro_in_fstring(self):
+        ns = run(using("source") + "s = f'{source!(a + b)}|{source!(c)!r}'")
+        self.assertEqual(ns["s"], "a + b|'c'")
+
