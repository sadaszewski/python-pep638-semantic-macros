+class ProcessorTests(unittest.TestCase):
+
+    def test_macro_processor(self):
+        def func(node):
+            return node
+        processor = macros.macro_processor(macros.STMT_MACRO, 108, "a", "b")(func)
+        self.assertEqual(processor,
+                         (func, macros.STMT_MACRO, 108, ("a", "b")))
+
+    def test_invalid(self):
+        def func(node):
+            return node
+        with self.assertRaises(ValueError):
+            macros.macro_processor(0, 1)(func)
+        with self.assertRaises(TypeError):
+            macros.macro_processor(macros.STMT_MACRO, "1")(func)
+        with self.assertRaises(TypeError):
+            macros.macro_processor(macros.STMT_MACRO, 1, 2)(func)
+        with self.assertRaises(ValueError):
+            macros.macro_processor(macros.EXPR_MACRO, 1, "part")(func)
+        with self.assertRaises(TypeError):
+            macros.macro_processor(macros.EXPR_MACRO, 1)(None)
+        for processor in (func, (func, 1, 1), (func, 5, 1, ()),
+                          (func, macros.EXPR_MACRO, 1, ["a"])):
+            with self.subTest(processor=processor):
+                with self.assertRaises((TypeError, ValueError)):
+                    compile("x = m!()", "<test>", "exec",
+                            macros={"m": processor})
+
+    def test_new_name(self):
+        node = ast.parse("\nif x:\n  spam! x").body[0].body[0]
+        self.assertEqual(macros.new_name(node), "$$spam_3_2")
+        self.assertEqual(macros.new_name(node, "var"), "$var_3_2")
+
+    def test_expand(self):
+        tree = ast.parse(using("unless", "swap") + textwrap.dedent("""\
+            unless! a:
+                b = swap!(c, d)
+            """))
+        result = macros.expand(tree)
+        self.assertIs(result, tree)
+        self.assertEqual(ast.unparse(tree).splitlines()[1:],
+                         ["if not a:", "    b = (d, c)"])
+        scope = {}
+        macros.expand(ast.parse(using("swap")), macros=scope)
+        self.assertEqual(scope, {"swap": swap})
+        tree = ast.parse("exchange!(1, 2)", mode="eval")
+        tree = macros.expand(tree, macros={"exchange": swap})
+        self.assertEqual(ast.unparse(tree), "(2, 1)")
+        with self.assertRaises(TypeError):
+            macros.expand(tree, macros=[])
