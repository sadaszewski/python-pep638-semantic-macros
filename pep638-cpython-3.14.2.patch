+    def test_ast(self):
+        tree = ast.Expression(ast.StmtExpr(
+            ast.Assign([store("x")], ast.Constant(5)),
+            ast.BinOp(load("x"), ast.Mult(), load("x"))))
+        ast.fix_missing_locations(tree)
+        ns = {}
+        self.assertEqual(eval(compile(tree, "<test>", "eval"), ns), 25)
+        self.assertEqual(ns["x"], 5)
+
+    def test_validation(self):
+        tree = ast.Expression(ast.StmtExpr(
+            ast.Assign([ast.Constant(1)], ast.Constant(5)), load("x")))
+        ast.fix_missing_locations(tree)
+        with self.assertRaises(ValueError):
+            compile(tree, "<test>", "eval")
