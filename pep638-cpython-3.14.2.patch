+class StatementMacroTests(unittest.TestCase):
+
+    def test_statement_macro(self):
+        ns = run(using("unless") + """\
+            result = []
+            for i in range(4):
+                unless! i % 2:
+                    result.append(i)
+            """)
+        self.assertEqual(ns["result"], [0, 2])
+
+    def test_removed(self):
+        ns = run(using("nothing") + """\
+            nothing!
+            def f():
+                nothing!:
+                    undefined
+            x = f()
+            if x is None:
+                nothing! 1, 2
+            else:
+                nothing!
+            """)
+        self.assertIsNone(ns["x"])
+
+    def test_several_statements(self):
+        ns = run(using("repeat") + """\
+            x = 0
+            repeat! 3:
+                x += 1
+                x *= 2
+            """)
+        self.assertEqual(ns["x"], 14)
+
+    def test_as(self):
+        ns = run(using("bind") + "bind! 6 * 7 as answer")
+        self.assertEqual(ns["answer"], 42)
+
+    def test_module_result(self):
+        ns = run(using("parsed") + "parsed!")
+        self.assertEqual(ns["parsed_b"], 2)
+
+    def test_expansion_is_repeated(self):
+        ns = run(using("nested", "unless") + """\
+            nested! False:
+                x = 1
+            """)
+        self.assertEqual(ns["x"], 1)
+
+    def test_inner_macros_need_no_processor(self):
+        # "inner macros do not need to have processors registered"
+        ns = run(using("nothing") + """\
+            nothing!:
+                whatever! 1:
+                    x = else!(3)
+            """)
+        self.assertNotIn("x", ns)
+
+    def test_macro_body_assignment(self):
+        ns = run(using("table") + """\
+            table! colors:
+                "red" = 1
+                "blue" = 2
+                (1, 2) = "tuple"
+            """)
+        self.assertEqual(ns["colors"], {"red": 1, "blue": 2, (1, 2): "tuple"})
+
+    def test_multiple_parts(self):
+        code = using("attempt") + """\
+            log = []
+            attempt!:
+                log.append("body")
+                1 / 0
+            otherwise!:
+                log.append("otherwise")
+            lastly!:
+                log.append("lastly")
+            attempt!:
+                log.append("body 2")
+            lastly!:
+                log.append("lastly 2")
+            attempt!:
+                log.append("body 3")
+            """
+        ns = run(code)
+        self.assertEqual(ns["log"], ["body", "otherwise", "lastly",
+                                     "body 2", "lastly 2", "body 3"])
+
+    def test_part_without_macro(self):
+        with self.assertRaisesRegex(SyntaxError,
+                                    "macro 'lastly!' is not defined"):
+            run(using("attempt") + "x = 1\nlastly!:\n    pass\n")
+
+    def test_locations(self):
+        ns = run(using("unless") + """\
+            def f(x):
+                unless! x:
+                    raise ValueError
+            """)
+        try:
+            ns["f"](0)
+        except ValueError as exc:
+            self.assertEqual(exc.__traceback__.tb_next.tb_lineno, 4)
+        else:
