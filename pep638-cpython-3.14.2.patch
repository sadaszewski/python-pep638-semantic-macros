index 0000000..d6306c7
--- /dev/null
+++ b/Lib/macros.py
@@ -0,0 +1,523 @@
+"""Support for syntactic macros (PEP 638).
+
+A macro is a compile-time function that transforms a part of the program.
+Macros are marked in the source with an exclamation mark after their name:
+
+    from! mymacros import unless, trace     # import macros at compile time
+
+    unless! x > 10:                         # statement macro
+        print("small")
+
+    trace!                                  # sibling macro
+    def f(): ...
+
+    y = trace!(x + 1)                       # expression macro
+
+A macro processor is a four-tuple ``(func, kind, version, additional_names)``.
+*func* is called by the compiler with the abstract syntax tree of the macro
+(an ``ast.MacroStmt`` or ``ast.MacroExpr`` node) and returns the tree that
+replaces it.  The ``macro_processor`` decorator creates such a tuple:
+
+    import ast, macros
+
+    @macros.macro_processor(macros.STMT_MACRO, 1)
+    def unless(node):
+        return ast.If(test=ast.UnaryOp(ast.Not(), node.args),
+                      body=node.body, orelse=[])
+
+Macros are expanded by the compiler; ``ast.parse()`` returns the tree before
+expansion.  ``expand()`` expands the macros of a tree explicitly, which is
+useful to look at the result with ``ast.unparse()``.
+"""
+
+import ast
+from _ast import STMT_MACRO, SIBLING_MACRO, EXPR_MACRO
+
+__all__ = [
+    "STMT_MACRO", "SIBLING_MACRO", "EXPR_MACRO",
+    "macro_processor", "expand", "new_name",
+]
+
+_KIND_NAMES = {
+    STMT_MACRO: "statement macro",
+    SIBLING_MACRO: "sibling macro",
+    EXPR_MACRO: "expression macro",
+}
+
+# Name of the module level variable that records the macros used to compile
+# a module, and the marker that starts its value.  Both are known to
+# importlib, which uses them to check that cached bytecode is still valid.
+_MACROS_VARIABLE = "__macros__"
+_MACROS_MARKER = "$macros"
+
+# How many times in a row a macro may expand to another macro.
+_MAX_EXPANSIONS = 500
+
+
+def macro_processor(kind, version, *additional_names):
+    """Decorator to mark a function as a macro processor.
+
+    *kind* is one of STMT_MACRO, SIBLING_MACRO or EXPR_MACRO.  *version* is
+    an integer that must change whenever the output of the macro changes, so
+    that cached bytecode is regenerated.  *additional_names* are the names of
+    the additional parts of a multi-part statement macro.
+    """
+    def deco(func):
+        processor = (func, kind, version, additional_names)
+        _check_processor(processor)
+        return processor
+    return deco
+
+
+def new_name(node, variable=None):
+    """Return a name for a variable generated by a macro.
+
+    The name follows the scheme recommended by PEP 638: it cannot clash with
+    a name of the program as it is not a valid identifier, and it contains
+    the position of *node* (usually the macro being expanded).  Without
+    *variable* the name is purely artificial (``$$macro_17_0``), otherwise it
+    is derived from the name of that variable (``$var_12_5``).
+    """
+    lineno = getattr(node, "lineno", 0)
+    col_offset = getattr(node, "col_offset", 0)
+    if variable is None:
+        prefix = "$$" + getattr(node, "name", "macro")
+    else:
+        prefix = "$" + variable
+    return f"{prefix}_{lineno}_{col_offset}"
+
+
+def expand(tree, filename="<unknown>", macros=None):
+    """Expand the macros in the AST *tree* and return the expanded tree.
+
+    *tree* is modified in place.  *macros*, if given, is a dict mapping names
+    to macro processors: these macros can be used without importing them,
+    and the macros imported at the top level of *tree* are added to it.
+    """
+    if macros is not None and not isinstance(macros, dict):
+        raise TypeError("macros must be a dict or None, not "
+                        f"{type(macros).__name__}")
+    return _Expander(filename, macros).expand(tree)
+
+
+def _expand(tree, filename, macros):
+    # Called by the compiler for trees that contain macros.
+    return _Expander(filename, macros).expand(tree)
+
+
+def _check_processor(processor):
+    if not isinstance(processor, tuple) or len(processor) != 4:
+        raise TypeError("a macro processor must be a tuple "
+                        "(func, kind, version, additional_names), "
+                        f"not {_describe(processor)}")
+    func, kind, version, additional_names = processor
+    if not callable(func):
+        raise TypeError("the first item of a macro processor must be "
+                        f"callable, not {_describe(func)}")
+    if kind not in _KIND_NAMES or type(kind) is not int:
+        raise ValueError("the kind of a macro processor must be STMT_MACRO, "
+                         f"SIBLING_MACRO or EXPR_MACRO, not {kind!r}")
+    if not isinstance(version, int) or isinstance(version, bool):
+        raise TypeError("the version of a macro processor must be an "
+                        f"integer, not {_describe(version)}")
+    if (not isinstance(additional_names, tuple)
+            or not all(isinstance(name, str) for name in additional_names)):
+        raise TypeError("the additional names of a macro processor must be "
+                        "a tuple of strings")
+    if additional_names and kind != STMT_MACRO:
+        raise ValueError("only statement macros (STMT_MACRO) can have "
+                         "additional names")
+
+
+def _describe(obj):
+    if isinstance(obj, type):
+        return f"the class {obj.__name__!r}"
+    return f"{type(obj).__name__!r} object"
+
+
+_SCOPE_NODES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef,
+                ast.Lambda)
+
+
+class _Expander:
+
+    def __init__(self, filename, macros):
+        self.filename = filename
+        # The macros of the scopes being compiled, innermost last.
+        self.scopes = [macros if macros is not None else {}]
+        # (module name, name, version) of the macros that were imported.
+        self.imported = []
+
+    # -- errors --------------------------------------------------------------
+
+    def error_details(self, node):
+        lineno = getattr(node, "lineno", None)
+        if lineno is None:
+            return (self.filename, None, None, None)
+        col_offset = getattr(node, "col_offset", 0)
+        end_lineno = getattr(node, "end_lineno", None)
+        end_col_offset = getattr(node, "end_col_offset", None)
+        text = None
+        try:
+            import linecache
+            text = linecache.getline(self.filename, lineno) or None
+            if text is not None:
+                # col_offset is an offset in the UTF-8 encoded line
+                line = text.encode("utf-8")
+                col_offset = len(line[:col_offset].decode("utf-8", "replace"))
+                if end_lineno == lineno and end_col_offset is not None:
+                    end_col_offset = len(
+                        line[:end_col_offset].decode("utf-8", "replace"))
+        except Exception:
+            text = None
+        if end_lineno is None or end_col_offset is None:
+            return (self.filename, lineno, col_offset + 1, text)
+        return (self.filename, lineno, col_offset + 1, text,
+                end_lineno, end_col_offset + 1)
+
+    def error(self, message, node):
+        raise SyntaxError(message, self.error_details(node))
+
+    def call(self, func, node, *parts):
+        try:
+            return func(node, *parts)
+        except SyntaxError as exc:
+            # Let macro processors report errors in the use of the macro
+            # with a plain SyntaxError("message"), optionally with the
+            # lineno and offset of the node that is wrong.
+            if exc.filename is None:
+                exc.filename = self.filename
+                if exc.lineno is None:
+                    details = self.error_details(node)
+                    exc.lineno, exc.offset, exc.text = details[1:4]
+                    if len(details) > 4:
+                        exc.end_lineno, exc.end_offset = details[4:]
+                elif exc.text is None:
+                    try:
+                        import linecache
+                        exc.text = linecache.getline(self.filename,
+                                                     exc.lineno) or None
+                    except Exception:
+                        pass
+            raise
+        except Exception as exc:
+            lineno = getattr(node, "lineno", "?")
+            exc.add_note(f"(raised by the macro processor of "
+                         f"'{node.name}!' while compiling "
+                         f"{self.filename!r}, line {lineno})")
+            raise
+
+    # -- registry ------------------------------------------------------------
+
+    def lookup(self, node):
+        name = node.name
+        for scope in reversed(self.scopes):
+            processor = scope.get(name)
+            if processor is not None:
+                _check_processor(processor)
+                return processor
+        self.error(f"macro '{name}!' is not defined; it must be imported "
+                   f"with 'from! module import {name}' before it is used",
+                   node)
+
+    def dotted_name(self, node):
+        parts = []
+        expr = node.args
+        while isinstance(expr, ast.Attribute):
+            parts.append(expr.attr)
+            expr = expr.value
+        if not isinstance(expr, ast.Name):
+            self.error(f"'{node.name}!' must be followed by the dotted name "
+                       "of a module", node if node.args is None else expr)
+        parts.append(expr.id)
+        return ".".join(reversed(parts))
+
+    def import_macro(self, node):
+        # "import!" dotted_name "as" name
+        # "from!" dotted_name "import" name [ "as" name ]
+        if node.name == "from":
+            if node.importname is None or node.body:
+                self.error("invalid syntax for from!; expected "
+                           "'from! module import name [as name]'", node)
+            modname = self.dotted_name(node)
+            name = node.importname
+        else:
+            if node.importname is not None or node.body:
+                self.error("invalid syntax for import!; expected "
+                           "'import! module.name as name'", node)
+            modname, _, name = self.dotted_name(node).rpartition(".")
+            if not modname:
+                self.error("import! requires the dotted name of a macro "
+                           "processor: 'import! module.name as name'", node)
+        asname = node.asname or name
+
+        import importlib
+        try:
+            module = importlib.import_module(modname)
+        except SyntaxError:
+            raise
+        except ImportError as exc:
+            exc.add_note(f"(compile-time import by '{node.name}!' while "
+                         f"compiling {self.filename!r}, line {node.lineno})")
+            raise
+        try:
+            processor = getattr(module, name)
+        except AttributeError:
+            hint = ""
+            spec = getattr(module, "__spec__", None)
+            if getattr(spec, "_initializing", False):
+                hint = (" (the module is still being imported: a macro "
+                        "cannot be used in the module that defines it)")
+            raise ImportError(
+                f"cannot import macro {name!r} from {modname!r}{hint}",
+                name=modname, path=getattr(module, "__file__", None)) from None
+        try:
+            _check_processor(processor)
+        except (TypeError, ValueError) as exc:
+            self.error(f"'{modname}.{name}' is not a macro processor: {exc}",
+                       node)
+        self.scopes[-1][asname] = processor
+        entry = (modname, name, processor[2])
+        if entry not in self.imported:
+            self.imported.append(entry)
+
+    # -- expansion -----------------------------------------------------------
+
+    def expand(self, tree):
+        if isinstance(tree, ast.Module):
+            tree.body = self.block(tree.body)
+            if self.imported:
+                self.record_imported(tree)
+        elif isinstance(tree, ast.Interactive):
+            tree.body = self.block(tree.body)
+            if not tree.body:
+                tree.body = [self.located(ast.Pass(), None)]
+        elif isinstance(tree, ast.stmt):
+            body = self.block([tree])
+            if len(body) != 1:
+                raise ValueError("the statement expands to "
+                                 f"{len(body)} statements")
+            return body[0]
+        elif isinstance(tree, ast.AST):
+            return self.visit(tree)
+        else:
+            raise TypeError(f"expected an AST, not {_describe(tree)}")
+        return tree
+
+    def record_imported(self, tree):
+        # __macros__ = ("$macros", (module, name, version), ...)
+        # This makes the macros used by a module available at run time, and
+        # is used by importlib to check that the bytecode of the module was
+        # generated by the current versions of the macros.
+        value = ast.Constant((_MACROS_MARKER, *self.imported))
+        target = ast.Name(_MACROS_VARIABLE, ast.Store())
+        assign = ast.Assign([target], value)
+        for node in (value, target, assign):
+            node.lineno = node.end_lineno = 1
+            node.col_offset = node.end_col_offset = 0
+        # after the docstring and the __future__ imports
+        index = 0
+        body = tree.body
+        if (body and isinstance(body[0], ast.Expr)
+                and isinstance(body[0].value, ast.Constant)
+                and isinstance(body[0].value.value, str)):
+            index = 1
+        while (index < len(body) and isinstance(body[index], ast.ImportFrom)
+               and body[index].module == "__future__"):
+            index += 1
+        body.insert(index, assign)
+
+    def block(self, stmts):
+        """Expand the macros in a list of statements."""
+        result = []
+        # Stack of (statement, number of expansions that produced it).
+        pending = [(stmt, 0) for stmt in reversed(stmts)]
+        while pending:
+            stmt, depth = pending.pop()
+            if isinstance(stmt, ast.MacroStmt):
+                if depth > _MAX_EXPANSIONS:
+                    self.error(f"macro '{stmt.name}!' is expanded "
+                               "recursively without end", stmt)
+                expansion = self.expand_stmt(stmt, pending)
+                pending.extend((new, depth + 1)
+                               for new in reversed(expansion))
+            else:
+                result.append(self.visit(stmt))
+        return result
+
+    def take_statement(self, node, pending):
+        """Remove and return the statement that follows a sibling macro."""
+        if not pending:
+            self.error(f"sibling macro '{node.name}!' must be followed by "
+                       "a statement in the same block", node)
+        stmt, _ = pending.pop()
+        if (isinstance(stmt, ast.MacroStmt) and not stmt.body
+                and stmt.name not in ("import", "from")):
+            # A sibling macro applied to a sibling macro: the inner macro
+            # gets its statement first.
+            for scope in reversed(self.scopes):
+                processor = scope.get(stmt.name)
+                if processor is not None:
+                    _check_processor(processor)
+                    if processor[1] == SIBLING_MACRO:
+                        stmt.body = [self.take_statement(stmt, pending)]
+                    break
+        return stmt
+
+    def expand_stmt(self, node, pending):
+        """Expand a macro statement; return the list of statements that
+        replaces it. Statements that are part of the macro are removed from
+        *pending*."""
+        name = node.name
+        if name in ("import", "from"):
+            self.import_macro(node)
+            return []
+        func, kind, version, additional_names = self.lookup(node)
+        if kind == EXPR_MACRO:
+            self.error(f"'{name}!' is an expression macro, it cannot be "
+                       "used as a statement (a statement that starts with "
+                       f"'{name}!' is a macro statement; put the expression "
+                       "in parentheses)", node)
+        parts = []
+        if kind == SIBLING_MACRO:
+            if node.importname is not None or node.asname is not None:
+                self.error(f"sibling macro '{name}!' does not accept "
+                           "'import' or 'as'", node)
+            if not node.body:
+                node.body = [self.take_statement(node, pending)]
+            elif len(node.body) != 1:
+                self.error(f"'{name}!' is a sibling macro, it applies to "
+                           "the statement that follows it and cannot have "
+                           "an indented body", node)
+        else:
+            for part in additional_names:
+                if (pending and isinstance(pending[-1][0], ast.MacroStmt)
+                        and pending[-1][0].name == part):
+                    parts.append(pending.pop()[0])
+                else:
+                    parts.append(None)
+        result = self.call(func, node, *parts)
+        if result is None:
+            stmts = []
+        elif isinstance(result, ast.AST):
+            stmts = [result]
+        elif isinstance(result, (list, tuple)):
+            stmts = list(result)
+        else:
+            raise TypeError(f"the macro processor of '{name}!' must return "
+                            f"an AST, not {_describe(result)}")
+        for i, stmt in enumerate(stmts):
+            if isinstance(stmt, ast.expr):
+                stmts[i] = stmt = ast.Expr(stmt)
+            elif isinstance(stmt, ast.Module) and len(stmts) == 1:
+                # the result of ast.parse()
+                stmts = list(stmt.body)
+                break
+            elif not isinstance(stmt, ast.stmt):
+                raise TypeError(f"the macro processor of '{name}!' must "
+                                "return statements, not "
+                                f"{_describe(stmt)}")
+        for stmt in stmts:
+            self.fix_locations(stmt, node)
+        return stmts
+
+    def expand_expr(self, node):
+        """Expand a macro expression; return the expression that replaces
+        it."""
+        depth = 0
+        while isinstance(node, ast.MacroExpr):
+            name = node.name
+            if depth > _MAX_EXPANSIONS:
+                self.error(f"macro '{name}!' is expanded recursively "
+                           "without end", node)
+            if name in ("import", "from"):
+                self.error(f"'{name}!' cannot be used in an expression", node)
+            func, kind, version, additional_names = self.lookup(node)
+            if kind != EXPR_MACRO:
+                self.error(f"'{name}!' is a {_KIND_NAMES[kind]}, it cannot "
+                           "be used in an expression", node)
+            result = self.call(func, node)
+            if not isinstance(result, ast.expr):
+                raise TypeError(f"the macro processor of '{name}!' must "
+                                "return an expression, not "
+                                f"{_describe(result)}")
+            self.fix_locations(result, node)
+            node = result
+            depth += 1
+        return node
+
+    def visit(self, node):
+        """Expand the macros in *node*, which is not a macro statement."""
+        if isinstance(node, ast.MacroExpr):
+            node = self.expand_expr(node)
+        scoped = isinstance(node, _SCOPE_NODES)
+        if scoped:
+            self.scopes.append({})
+        try:
+            for field in node._fields:
+                try:
+                    value = getattr(node, field)
+                except AttributeError:
+                    continue
+                if isinstance(value, list):
+                    if any(isinstance(item, ast.stmt) for item in value):
+                        value = self.block(value)
+                        if not value:
+                            # all the statements were removed by macros
+                            value = [self.located(ast.Pass(), node)]
+                    else:
+                        value = [self.visit(item)
+                                 if isinstance(item, ast.AST) else item
+                                 for item in value]
+                    setattr(node, field, value)
+                elif isinstance(value, ast.MacroStmt):
+                    # the statement of a StmtExpr
+                    body = self.block([value])
+                    if len(body) == 1:
+                        value = body[0]
+                    elif not body:
+                        value = self.located(ast.Pass(), value)
+                    else:
+                        test = self.located(ast.Constant(True), value)
+                        value = self.located(ast.If(test, body, []), value)
+                    setattr(node, field, value)
+                elif isinstance(value, ast.AST):
+                    setattr(node, field, self.visit(value))
+        finally:
+            if scoped:
+                self.scopes.pop()
+        return node
+
+    # -- locations -----------------------------------------------------------
+
+    def located(self, new, node):
+        new.lineno = getattr(node, "lineno", 1)
+        new.col_offset = getattr(node, "col_offset", 0)
+        new.end_lineno = getattr(node, "end_lineno", new.lineno)
+        new.end_col_offset = getattr(node, "end_col_offset", new.col_offset)
+        return new
+
+    def fix_locations(self, tree, macro):
+        """Give the nodes created by a macro processor without a location
+        the location of the macro."""
+        todo = [tree]
+        while todo:
+            node = todo.pop()
+            if "lineno" in node._attributes:
+                if getattr(node, "lineno", None) is None:
+                    self.located(node, macro)
+                else:
+                    if getattr(node, "col_offset", None) is None:
+                        node.col_offset = 0
+                    if getattr(node, "end_lineno", None) is None:
+                        node.end_lineno = node.lineno
+                        node.end_col_offset = node.col_offset
+                    elif getattr(node, "end_col_offset", None) is None:
+                        node.end_col_offset = node.col_offset
+            for field in node._fields:
+                value = getattr(node, field, None)
+                if isinstance(value, ast.AST):
+                    todo.append(value)
+                elif isinstance(value, list):
+                    todo.extend(item for item in value
+                                if isinstance(item, ast.AST))
