+class BytecodeCacheTests(unittest.TestCase):
+
+    def test_version(self):
+        # "version is used to track versions of macros, so that generated
+        # bytecodes can be correctly cached"
+        with os_helper.temp_dir() as path, \
+             import_helper.DirsOnSysPath(path):
+            def write_macros(version, value):
+                with open(os.path.join(path, "_tm_defs.py"), "w") as f:
+                    f.write(textwrap.dedent(f"""\
+                        import ast, macros
+                        @macros.macro_processor(macros.EXPR_MACRO, {version})
+                        def value(node):
+                            return ast.Constant({value!r})
+                        """))
+                importlib.invalidate_caches()
+                sys.modules.pop("_tm_defs", None)
+                sys.modules.pop("_tm_user", None)
+
+            self.addCleanup(sys.modules.pop, "_tm_defs", None)
+            self.addCleanup(sys.modules.pop, "_tm_user", None)
+            with open(os.path.join(path, "_tm_user.py"), "w") as f:
+                f.write("from! _tm_defs import value\nx = value!()\n")
+
+            write_macros(1, "one")
+            user = importlib.import_module("_tm_user")
+            self.assertEqual(user.x, "one")
+            self.assertEqual(user.__macros__,
+                             ("$macros", ("_tm_defs", "value", 1)))
+            if sys.dont_write_bytecode:
+                self.skipTest("bytecode is not written")
+            self.assertTrue(os.path.exists(user.__cached__))
+
+            # Same version: the cached bytecode is used.
+            write_macros(1, "changed, but not the version")
+            user = importlib.import_module("_tm_user")
+            self.assertEqual(user.x, "one")
+
+            # Other version: the module is compiled again.
+            write_macros(2, "two")
+            user = importlib.import_module("_tm_user")
+            self.assertEqual(user.x, "two")
+            self.assertEqual(user.__macros__,
+                             ("$macros", ("_tm_defs", "value", 2)))
+
+    def test_own_module(self):
+        with os_helper.temp_dir() as path, \
+             import_helper.DirsOnSysPath(path):
+            with open(os.path.join(path, "_tm_self.py"), "w") as f:
+                f.write("import macros\n"
+                        "m = (lambda node: node, macros.EXPR_MACRO, 1, ())\n"
+                        "from! _tm_self import m\n")
+            importlib.invalidate_caches()
+            self.addCleanup(sys.modules.pop, "_tm_self", None)
+            with self.assertRaisesRegex(ImportError, "cannot be used in the "
+                                        "module that defines it"):
+                importlib.import_module("_tm_self")
+
+
+if __name__ == "__main__":
+    unittest.main()
