diff --git a/Lib/_ast_unparse.py b/Lib/_ast_unparse.py
index 1c8741b..93e3110 100644
--- a/Lib/_ast_unparse.py
+++ b/Lib/_ast_unparse.py
@@ -231,6 +231,41 @@ def visit_Expr(self, node):
         self.set_precedence(_Precedence.YIELD, node.value)
         self.traverse(node.value)
 
+    # PEP 638
+
+    def visit_MacroStmt(self, node):
+        self.fill(node.name + "!", allow_semicolon=not node.body)
+        if node.args is not None:
+            self.write(" ")
+            self.set_precedence(_Precedence.TUPLE, node.args)
+            self.traverse(node.args)
+        if node.importname is not None:
+            self.write(" import " + node.importname)
+        if node.asname is not None:
+            self.write(" as " + node.asname)
+        if node.body:
+            with self.block():
+                self.traverse(node.body)
+
+    def visit_MacroExpr(self, node):
+        self.write(node.name + "!")
+        if isinstance(node.args, GeneratorExp):
+            self.traverse(node.args)
+            return
+        with self.delimit("(", ")"):
+            if node.args is not None:
+                self.set_precedence(_Precedence.TUPLE, node.args)
+                self.traverse(node.args)
+
+    def visit_StmtExpr(self, node):
+        # There is no syntax for statement expressions, they can only be
+        # created by macros. Use a notation that shows what is executed.
+        stmt = type(self)().visit(node.stmt).strip("\n")
+        stmt = stmt.replace("\n", "\n" + "    " * (self._indent + 1))
+        with self.delimit("$stmt_expr(", ")"):
+            self.write(stmt, "; ")
+            self.traverse(node.value)
+
     def visit_NamedExpr(self, node):
         with self.require_parens(_Precedence.NAMED_EXPR, node):
             self.set_precedence(_Precedence.ATOM, node.target, node.value)
