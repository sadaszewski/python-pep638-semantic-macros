--- a/Parser/action_helpers.c
+++ b/Parser/action_helpers.c
@@ -1948,3 +1948,28 @@ _PyPegen_register_stmts(Parser *p, asdl_stmt_seq* stmts) {
     p->last_stmt_location.end_col_offset = last_stmt->end_col_offset;
     return stmts;
 }
+
+/* PEP 638: an "assignment" to arbitrary expressions in the body of a macro.
+
+   Return NULL without setting an exception if all the targets are valid
+   assignment targets, so that the statement is parsed as a regular
+   assignment. */
+stmt_ty
+_PyPegen_macro_assignment(Parser *p, asdl_expr_seq *targets, expr_ty value,
+                          int lineno, int col_offset, int end_lineno,
+                          int end_col_offset, PyArena *arena)
+{
+    int valid = 1;
+    for (Py_ssize_t i = 0; i < asdl_seq_LEN(targets); i++) {
+        expr_ty target = asdl_seq_GET(targets, i);
+        if (_PyPegen_get_invalid_target(target, STAR_TARGETS) != NULL) {
+            valid = 0;
+            break;
+        }
+    }
+    if (valid) {
+        return NULL;
+    }
+    return _PyAST_Assign(targets, value, NULL, lineno, col_offset, end_lineno,
+                         end_col_offset, arena);
+}
